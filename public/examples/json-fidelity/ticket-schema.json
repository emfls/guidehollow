{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Fixed two-ticket teaching fixture. Exact source fidelity requires a separate check.",
  "type": "object",
  "properties": {
    "records": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolved": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "problem",
          "error_code",
          "resolved"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "records"
  ],
  "additionalProperties": false
}
