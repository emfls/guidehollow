METHOD:PUBLISH
X-WR-CALNAME:Audit Recurrence Test Suite
X-WR-TIMEZONE:America/New_York
BEGIN:VTIMEZONE
TZID:America/New_York
X-LIC-LOCATION:America/New_York
BEGIN:DAYLIGHT
TZOFFSETFROM:-0500
TZOFFSETTO:-0400
TZNAME:EDT
DTSTART:19700308T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:-0400
TZOFFSETTO:-0500
TZNAME:EST
DTSTART:19701101T020000
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:audit-case-01-byday-bysetpos@guidehollow.com
DTSTAMP:20261123T090000Z
DTSTART;TZID=America/New_York:20261110T140000
DTEND;TZID=America/New_York:20261110T150000
SUMMARY:Case 1: Monthly Second Tuesday Board Sync (Correct RFC 5545)
DESCRIPTION:Demonstrates correct month-based position recurrence without client-side BYSETPOS ambiguity.
RRULE:FREQ=MONTHLY;BYDAY=2TU;INTERVAL=1
STATUS:CONFIRMED
END:VEVENT
BEGIN:VEVENT
UID:audit-case-02-exdate-holiday-exclusion@guidehollow.com
DTSTAMP:20261123T090000Z
DTSTART;TZID=America/New_York:20261126T100000
DTEND;TZID=America/New_York:20261126T110000
SUMMARY:Case 2: Weekly Thursday Standup with Thanksgiving EXDATE
DESCRIPTION:Weekly meeting properly excluding US Thanksgiving holiday via EXDATE.
RRULE:FREQ=WEEKLY;BYDAY=TH;INTERVAL=1
EXDATE;TZID=America/New_York:20261126T100000
STATUS:CONFIRMED
END:VEVENT
BEGIN:VEVENT
UID:audit-case-03-until-utc-boundary@guidehollow.com
DTSTAMP:20261123T090000Z
DTSTART;TZID=America/New_York:20261102T090000
DTEND;TZID=America/New_York:20261102T093000
SUMMARY:Case 3: Sprint Standup with Correct UTC UNTIL Boundary
DESCRIPTION:RFC 5545 requires UNTIL values to be specified in UTC format ending with Z.
RRULE:FREQ=DAILY;BYDAY=MO,TU,WE,TH,FR;UNTIL=20261127T235959Z
STATUS:CONFIRMED
END:VEVENT
END:VCALENDAR
