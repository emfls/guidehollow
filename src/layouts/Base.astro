---
import { site, categories } from '../config';
import '../styles/global.css';
interface Props { title: string; description?: string; noindex?: boolean; schema?: Record<string, unknown>; breadcrumbs?: { name: string; url: string }[] }
const { title, description = site.description, noindex = false, schema, breadcrumbs = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname, site.url).href;
const pageTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} | ${site.name}`;
const graph = [
  { '@type': 'Organization', '@id': `${site.url}/#organization`, name: site.name, url: site.url, logo: `${site.url}/favicon.svg` },
  { '@type': 'WebSite', '@id': `${site.url}/#website`, name: site.name, url: site.url, inLanguage: 'en-US' },
  ...(breadcrumbs.length ? [{ '@type': 'BreadcrumbList', itemListElement: [{ name: 'Home', url: '/' }, ...breadcrumbs].map((item, i) => ({ '@type': 'ListItem', position: i + 1, name: item.name, item: new URL(item.url, site.url).href })) }] : []),
  ...(schema ? [schema] : []),
];
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  <meta name="theme-color" content="#0C1214" /><meta name="color-scheme" content="dark light" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="GuideHollow RSS" href="/rss.xml" />
  <meta property="og:type" content={schema ? 'article' : 'website'} /><meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
  <meta property="og:locale" content="en_US" /><meta property="og:image" content={`${site.url}/social.png`} />
  <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="GuideHollow. A clearer path through AI." />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={pageTitle} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={`${site.url}/social.png`} />
  {site.verification.google && <meta name="google-site-verification" content={site.verification.google} />}
  {site.verification.bing && <meta name="msvalidate.01" content={site.verification.bing} />}
  {site.ads.publisherId && <meta name="google-adsense-account" content={site.ads.publisherId} />}
  {site.ads.servingEnabled && site.ads.consentReady && <script is:inline async crossorigin="anonymous" src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.ads.publisherId}`}></script>}
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')} />
  <script is:inline>
    (() => { try { const saved = localStorage.getItem('gh-theme'); if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved; } catch {} })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header"><div class="header-inner">
    <a href="/" class="brand" aria-label="GuideHollow home"><svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true"><path d="M7 6h18v20H7z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m12 12 4 4-4 4m6 0h4" fill="none" stroke="currentColor" stroke-width="2"/></svg><span>GuideHollow<span class="brand-dot">_</span></span></a>
    <nav aria-label="Main navigation" id="main-nav">{categories.map(c => <a href={`/${c.slug}/`} aria-current={Astro.url.pathname.startsWith(`/${c.slug}/`) ? 'page' : undefined}>{c.slug === 'ai-tools' ? 'AI Tools' : c.slug === 'prompts' ? 'Prompts' : c.name}</a>)}</nav>
    <div class="header-actions"><a class="search-shortcut" href="/search/" aria-label="Search guides">Search <kbd>⌘ K</kbd></a><button id="theme-toggle" class="icon-button" aria-label="Change color theme" title="Change color theme">◐</button><button id="menu-toggle" class="menu-toggle" aria-expanded="false" aria-controls="main-nav">Menu</button></div>
  </div></header>
  <main id="main" class="container">
    {breadcrumbs.length > 0 && <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li>{breadcrumbs.map((item, i) => <li>{i === breadcrumbs.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.url}>{item.name}</a>}</li>)}</ol></nav>}
    <slot />
  </main>
  <footer class="site-footer"><div class="container footer-grid"><div><a class="brand" href="/">GuideHollow<span class="brand-dot">_</span></a><p>{site.tagline}</p><p class="small muted">Independent guides for thoughtful AI use.</p></div><nav aria-label="About GuideHollow"><a href="/about/">About</a><a href="/editorial-policy/">Editorial Policy</a><a href="/contact/">Contact</a></nav><nav aria-label="Legal and feeds"><a href="/privacy-policy/">Privacy Policy</a><a href="/terms/">Terms of Use</a><a href="/rss.xml">RSS Feed</a></nav></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} GuideHollow</span><span class="mono">Built for clarity. Open to curiosity.</span><a href="#top" data-top>Back to top ↑</a></div></footer>
  <script>import '../scripts/site';</script>
</body></html>
