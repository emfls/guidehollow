---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import AdSlot from '../../components/AdSlot.astro';
import { publishedArticles, articleUrl, readingTime, displayDate } from '../../lib/content';
import { categories, site } from '../../config';
export async function getStaticPaths() { return (await publishedArticles()).map(post => ({params: { category: post.data.category, slug: post.data.slug }, props: {post} })); }
const { post } = Astro.props;
const visualBySlug: Record<string,{ src:string; alt:string; caption:string }> = {
  'extract-meeting-action-items-with-ai': {
    src: '/visuals/meeting-notes-approval-boundary.svg',
    alt: 'Approved meeting notes move through three verification questions to a factual action summary, while unapproved suggestions remain excluded.',
    caption: 'A practical boundary: only approved decisions and explicitly assigned tasks enter the action summary. Illustrative process diagram.',
  },
};
const visual = visualBySlug[post.data.slug];
const { Content, headings } = await render(post);
const category = categories.find(c => c.slug === post.data.category)!;
const others = (await publishedArticles()).filter(p => p.id !== post.id);
const related = others.sort((a,b) => b.data.tags.filter(t => post.data.tags.includes(t)).length - a.data.tags.filter(t => post.data.tags.includes(t)).length).slice(0,3);
const schema = { '@type': 'BlogPosting', headline: post.data.title, description: post.data.description, datePublished: post.data.publishedDate.toISOString(), dateModified: post.data.updatedDate.toISOString(), author: { '@type': 'Organization', name: post.data.author, url: `${site.url}/editorial-policy/` }, publisher: { '@id': `${site.url}/#organization` }, mainEntityOfPage: new URL(articleUrl(post), site.url).href, image: `${site.url}/social.png`, inLanguage:'en-US' };
---
<Base title={post.data.title} description={post.data.description} schema={schema} breadcrumbs={[{name:category.name,url:`/${category.slug}/`},{name:post.data.title,url:articleUrl(post)}]}>
  <header class="article-heading"><p class="eyebrow mint">/ {category.name} <span class="muted">· {readingTime(post)} min read</span></p><h1>{post.data.title}</h1><p class="lede">{post.data.description}</p><div class="article-meta"><a href="/editorial-policy/">{post.data.author}</a><span>Published <time datetime={post.data.publishedDate.toISOString()}>{displayDate(post.data.publishedDate)}</time></span><span>Updated <time datetime={post.data.updatedDate.toISOString()}>{displayDate(post.data.updatedDate)}</time></span></div><div class="tags">{post.data.tags.map(tag => <a href={`/tags/${tag}/`}>#{tag}</a>)}</div></header>
  {visual && <figure class="article-visual"><img src={visual.src} alt={visual.alt} width="1200" height="460" decoding="async" /><figcaption>{visual.caption}</figcaption></figure>}
  <div class="reading-layout"><aside class="toc"><details open><summary>On this page</summary><nav aria-label="Table of contents"><ol>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}<li><a href="#official-sources">Official sources</a></li></ol></nav></details><a class="text-link" href="/tools/ai-response-checklist/">Check an AI answer →</a></aside>
  <div><article class="prose" data-pagefind-body><Content /><section class="sources" id="official-sources"><h2>Official sources</h2><p class="small muted">Reference details and review dates appear in the guide. Product features can change; follow the linked source for current information.</p><ul>{post.data.sources.map(source => <li><a href={source.url} rel="noopener noreferrer">{source.title} ↗</a></li>)}</ul><p class="small">See this guide for which examples were constructed, reproduced, or independently checked.</p></section></article><AdSlot /><p class="correction-note">Something unclear or out of date? <a href="/contact/">Suggest a correction.</a></p></div></div>
  <section class="section"><div class="section-heading"><div><p class="eyebrow mint">/ keep_exploring</p><h2>Related reading</h2></div></div><ArticleList posts={related} /></section>
</Base>
