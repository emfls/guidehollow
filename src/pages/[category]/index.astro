---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { publishedArticles, articleUrl } from '../../lib/content';
import { categories } from '../../config';
export function getStaticPaths() { return categories.map(category => ({ params: { category: category.slug }, props: { category } })); }
const { category } = Astro.props;
const posts = (await publishedArticles()).filter(p => p.data.category === category.slug);
const tasks: Record<string, [string, string, string][]> = {
  guides: [
    ['what-is-generative-ai', 'Decide whether AI fits your task', 'Compare drafting, finding a current fact, and checking a calculation.'],
    ['ai-privacy-basics', 'Prepare material before sharing it', 'Work through a fictional record and decide what to remove or keep.'],
    ['how-to-use-ai-for-spreadsheet-tasks', 'Check an AI-suggested formula', 'Download sample data and compare the calculated results with expected values.'],
    ['audit-ai-monthly-totals-with-timestamps', 'Diagnose a month-end total that misses late-night sales', 'Reconcile ten timestamped rows, check date parsing, and compare a safe half-open interval with the faulty midnight cutoff.'],
    ['how-to-summarize-long-documents-with-ai', 'Find omissions in a document summary', 'Compare a supplied source, observed response, and section-by-section review.'],
  ],
  prompts: [
    ['how-to-write-better-ai-prompts', 'Repair one vague request', 'Turn release notes into a bounded prompt and check five output requirements.'],
    ['a-practical-ai-prompt-framework', 'Organize a task with several deliverables', 'Separate inputs and limits, then review a handoff table and open questions.'],
    ['how-to-build-reusable-prompt-templates', 'Repeat a task with different inputs', 'Separate stable rules from changing fields and inspect three input conditions.'],
    ['test-ai-prompts-with-evaluation-dataset', 'Compare two prompt versions', 'Use eight cases and a scoring worksheet; keep raw outputs separate from judgments.'],
  ],
  'ai-tools': [
    ['getting-started-with-chatgpt', 'Complete your first verifiable ChatGPT task', 'Use fictional notes and a two-turn correction rather than treating a fluent first answer as proof.'],
    ['chatgpt-search-vs-deep-research-vs-standard-chat', 'Choose chat, Search, or Deep Research', 'Define whether you need drafting, one current source, or a multi-source investigation before selecting a tool.'],
    ['chatgpt-projects-recurring-work-setup', 'Set up a recurring project without mixing approvals', 'Separate approved reference files from drafts and understand project sharing and memory boundaries.'],
    ['how-to-use-chatgpt-search', 'Check the actual source behind a search result', 'Compare a retrieved passage with the exact claim, and record what it still cannot establish.'],
  ],
  troubleshooting: [
    ['why-ai-gives-wrong-answers', 'Diagnose one wrong answer before requesting a rewrite', 'Mark unsupported facts, ambiguity and source mismatches separately.'],
    ['chatgpt-file-upload-problems', 'Isolate an upload failure without sharing private files', 'Distinguish limits, file formats, network problems and missing document content.'],
    ['how-to-handle-ai-context-limits', 'Recover context without losing approved facts', 'Use a checked handoff rather than trusting an increasingly long conversation.'],
    ['api-key-pasted-into-chatgpt-incident-response', 'Respond safely to an exposed credential', 'Revoke with the issuer, assess usage and do not mistake chat deletion for key revocation.'],
  ],
};
const routes = (tasks[category.slug] ?? []).flatMap(([slug, task, result]) => {
  const post = posts.find(p => p.data.slug === slug);
  return post ? [{post, task, result}] : [];
});
---
<Base title={category.name} description={category.description} breadcrumbs={[{name:category.name,url:`/${category.slug}/`}]}>
<header class="page-heading"><p class="eyebrow mint">/ {category.command}</p><h1>{category.name}</h1><p>{category.description}</p></header>
{routes.length > 0 && <section class="section" aria-labelledby="choose-task"><div class="section-heading"><div><p class="eyebrow mint">/ choose_a_task</p><h2 id="choose-task">What are you trying to finish?</h2></div></div><ol class="start-path">{routes.map(({post, task, result}, i) => <li><span class="path-number">0{i + 1}</span><div><h3><a href={articleUrl(post)}>{task}</a></h3><p>{result}</p></div></li>)}</ol><p class="small muted">Choose the task closest to yours, then compare your result with the guide's checks. All articles are listed below.</p></section>}
{category.slug === 'ai-tools' && <section class="section prose info-content" aria-labelledby="tool-decisions"><h2 id="tool-decisions">Decide which kind of answer you actually need</h2><p>Different AI features solve different problems. Begin with the evidence and the decision, not a product label. A regular conversation is useful for outlining an email or reorganizing text you already understand. Search becomes more relevant when an answer depends on a current third-party statement. Deep Research is for a larger evidence-gathering task where several sources, conflicting claims and explicit coverage matter; availability and limits can depend on your plan.</p><table><thead><tr><th>Your task</th><th>A reasonable starting point</th><th>What still needs checking</th></tr></thead><tbody><tr><td>Rewrite a paragraph of fictional meeting notes</td><td>Standard conversation</td><td>Whether people, dates and commitments stayed unchanged</td></tr><tr><td>Find the latest official product documentation</td><td>Search with primary sources</td><td>Whether the linked page actually supports each feature claim</td></tr><tr><td>Compare competing approaches across several documents</td><td>Multi-source research with an evidence table</td><td>Coverage gaps, publication dates and contrary evidence</td></tr></tbody></table><p><strong>Stop condition:</strong> if you cannot name the original source for an important assertion, do not present the generated statement as independently confirmed. If you are working with private workplace material, check your organization's sharing rules and the product's current data controls before uploading anything. These are editorial routing recommendations, not guarantees of specific model access or performance.</p></section>}
{category.slug === 'troubleshooting' && <section class="section prose info-content" aria-labelledby="triage-guide"><h2 id="triage-guide">First identify which failure you have</h2><p>A fluent but inaccurate answer, an upload failure, lost context and a leaked credential may all feel like “AI is broken.” They require different responses. Use the smallest reversible check first and stop before a mistake becomes a disclosure or an unapproved decision.</p><table><thead><tr><th>Symptom</th><th>First useful check</th><th>Do not do this</th></tr></thead><tbody><tr><td>The answer cites a source but adds an unconfirmed date or price</td><td>Open the original reference and label the precise claim supported, contradicted or unknown</td><td>Ask the same model to certify its own answer without evidence</td></tr><tr><td>The tool cannot read a file</td><td>Check the original file locally, its format, size and whether selectable text exists; retry with a non-sensitive sample</td><td>Publish the private file to a public link just to test access</td></tr><tr><td>The assistant forgets approved constraints</td><td>Make a short, source-linked handoff of confirmed facts and current boundaries</td><td>Treat an earlier unverified guess as a new approved fact</td></tr><tr><td>You accidentally pasted an API key</td><td>Revoke or rotate the credential at its issuer and review usage</td><td>Assume deleting the chat makes the credential safe again</td></tr></tbody></table><p>These are general first actions, not incident investigations or tests of a particular AI service. For consequential harm, seek the appropriate service operator or professional support rather than experimenting with sensitive data.</p></section>}
{category.slug === 'tools' && <section class="section prose" aria-labelledby="tool-checks-title"><h2 id="tool-checks-title">Four checks, four different purposes</h2><p>Start with the question that you can actually test. The prompt builder organizes the inputs and output format for a task; it cannot prove that an AI answer is true. The response checklist helps you inspect source claims, omissions and uncertainty; marking boxes does not verify a claim by itself. The weighted-average workbench checks numbers independently, but it is not an accounting system. The source claim verifier teaches the difference between contradicted and unknown statements using original cases; it cannot independently certify real-world claims.</p><p>If you want a downloadable reference dataset with an expected answer, open the <a href="/evidence/">Evidence Library</a> and try one deliberate failure case before using any tool with your own information. Avoid entering confidential customer or workplace records.</p></section>}
{category.slug === 'tools' ? <div class="tools-grid"><a class="tool-card" href="/tools/ai-prompt-builder/"><span class="eyebrow mint">Compose / no AI required</span><h2>AI Prompt Builder ↗</h2><p>Combine your goal, context, audience, constraints, and output format into a prompt you can copy or download.</p></a><a class="tool-card" href="/tools/ai-response-checklist/"><span class="eyebrow mint">Review / use your judgment</span><h2>AI Response Quality Checklist ↗</h2><p>Work through six practical checks before relying on an AI response. Track your review without sending us your data.</p></a><a class="tool-card" href="/tools/weighted-price-checker/"><span class="eyebrow mint">Audit / reproduce the numbers</span><h2>Weighted Average Audit Workbench ↗</h2><p>Paste fictional CSV data, check per-row revenue, reconcile channel totals, and flag missing prices before trusting AI arithmetic.</p></a><a class="tool-card" href="/tools/claim-checker/"><span class="eyebrow mint">Verify / original source exercise</span><h2>Source Claim Verifier ↗</h2><p>Compare 5 or all 22 fictional claims with their primary notes and see evidence-based feedback.</p></a></div> : <><p class="small muted mono">{posts.length} {posts.length === 1 ? 'guide' : 'guides'} / open a guide to get started</p><ArticleList posts={posts} /></>}
</Base>
