---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { publishedArticles, articleUrl } from '../../lib/content';
import { categories } from '../../config';
export function getStaticPaths() { return categories.map(category => ({ params: { category: category.slug }, props: { category } })); }
const { category } = Astro.props;
const posts = (await publishedArticles()).filter(p => p.data.category === category.slug);
const tasks: Record<string, [string, string, string][]> = {
  guides: [
    ['what-is-generative-ai', 'Decide whether AI fits your task', 'Compare drafting, finding a current fact, and checking a calculation.'],
    ['ai-privacy-basics', 'Prepare material before sharing it', 'Work through a fictional record and decide what to remove or keep.'],
    ['extract-meeting-action-items-with-ai', 'Extract approved meeting tasks without inventing deadlines', 'Review 15 fictional claims against draft and approved minutes; keep owners, conditions, and missing dates accurate.'],
    ['ai-project-brief-requirements-traceability-matrix', 'Build requirements without silently approving new scope', 'Compare a nine-line brief, two traceability registers and an offline checker; catch errors a code-only check misses.'],
    ['how-to-use-ai-for-spreadsheet-tasks', 'Check an AI-suggested formula', 'Download sample data and compare the calculated results with expected values.'],
    ['audit-ai-monthly-totals-with-timestamps', 'Diagnose a month-end total that misses late-night sales', 'Reconcile ten timestamped rows, check date parsing, and compare a safe half-open interval with the faulty midnight cutoff.'],
    ['ai-valid-json-without-inventing-data', 'Catch a JSON output that parses but changes the facts', 'Run ten original cases through syntax, structure and source-reference checks without uploading private data.'],
    ['how-to-summarize-long-documents-with-ai', 'Find omissions in a document summary', 'Compare a supplied source, observed response, and section-by-section review.'],
  ],
  prompts: [
    ['how-to-write-better-ai-prompts', 'Repair one vague request', 'Turn release notes into a bounded prompt and check five output requirements.'],
    ['a-practical-ai-prompt-framework', 'Organize a task with several deliverables', 'Separate inputs and limits, then review a handoff table and open questions.'],
    ['how-to-build-reusable-prompt-templates', 'Repeat a task without leaking old names or deadlines', 'Use six fictional input cases, render each prompt independently and compare a flawed action worksheet against a checked reference.'],
    ['test-ai-prompts-with-evaluation-dataset', 'Compare two prompt versions', 'Use eight cases and a scoring worksheet; keep raw outputs separate from judgments.'],
    ['few-shot-prompt-examples-teach-rules-not-keywords', 'Test whether examples teach intent instead of keywords', 'Use twelve unseen fictional feedback cases and an offline grader to inspect wrong labels versus format errors.'],
    ['revise-one-ai-answer-section-without-changing-approved-text', 'Change only one approved answer section', 'Keep two frozen lines byte-for-byte and test why valid-looking questions can still introduce unsupported claims.'],
  ],
  'ai-tools': [
    ['getting-started-with-chatgpt', 'Complete your first verifiable ChatGPT task', 'Use fictional notes and a two-turn correction rather than treating a fluent first answer as proof.'],
    ['chatgpt-search-vs-deep-research-vs-standard-chat', 'Choose chat, Search, or Deep Research by evidence need', 'Audit 12 fictional source-backed product claims, including superseded instructions and gaps that must not be treated as denials.'],
    ['chatgpt-projects-recurring-work-setup', 'Set up a recurring project without mixing approvals', 'Separate approved reference files from drafts and understand project sharing and memory boundaries.'],
    ['how-to-use-chatgpt-search', 'Check the actual source behind a search result', 'Compare a retrieved passage with the exact claim, and record what it still cannot establish.'],
    ['notebooklm-source-checked-study-guide', 'Test a source-grounded study guide against the original files', 'Download three fictional sources, classify ten claims, and check how an obsolete agenda should be treated.'],
  ],
  troubleshooting: [
    ['why-ai-gives-wrong-answers', 'Diagnose one wrong answer before requesting a rewrite', 'Mark unsupported facts, ambiguity and source mismatches separately.'],
    ['chatgpt-file-upload-problems', 'Isolate an upload failure without sharing private files', 'Distinguish limits, file formats, network problems and missing document content.'],
    ['how-to-handle-ai-context-limits', 'Recover context without losing approved facts', 'Use a checked handoff rather than trusting an increasingly long conversation.'],
    ['api-key-pasted-into-chatgpt-incident-response', 'Practice a credential-exposure response without handling real keys', 'Audit ten fictional incident events and distinguish issuer revocation, restored workloads, saved copies and unsupported closure claims.'],
    ['chatgpt-shared-links-audit-revoke-access', 'Audit a ChatGPT share before trusting or revoking a URL', 'Inspect 14 synthetic URL patterns and eight deletion cases; distinguish link access from copies saved by recipients.'],
  ],
};
const routes = (tasks[category.slug] ?? []).flatMap(([slug, task, result]) => {
  const post = posts.find(p => p.data.slug === slug);
  return post ? [{post, task, result}] : [];
});
---
<Base title={category.name} description={category.description} breadcrumbs={[{name:category.name,url:`/${category.slug}/`}]}>
<header class="page-heading"><p class="eyebrow mint">/ {category.command}</p><h1>{category.name}</h1><p>{category.description}</p></header>
{routes.length > 0 && <section class="section" aria-labelledby="choose-task"><div class="section-heading"><div><p class="eyebrow mint">/ choose_a_task</p><h2 id="choose-task">What are you trying to finish?</h2></div></div><ol class="start-path">{routes.map(({post, task, result}, i) => <li><span class="path-number">0{i + 1}</span><div><h3><a href={articleUrl(post)}>{task}</a></h3><p>{result}</p></div></li>)}</ol><p class="small muted">Choose the task closest to yours, then compare your result with the guide's checks. All articles are listed below.</p></section>}
{category.slug === 'guides' && <section class="section prose info-content" aria-labelledby="guides-method-heading"><h2 id="guides-method-heading">Match your task to the right verification method</h2><p>AI output mistakes rarely happen randomly—they cluster around specific work formats. Summaries compress away financial qualifications and deadlines; spreadsheets silently change column cutoffs or average across unequal unit counts; JSON generators rename keys or insert defaults for missing fields; chart descriptions mistake local rebounds for steady upward trends.</p><table><thead><tr><th>Document or data type</th><th>Most common AI failure</th><th>First defense before relying on the output</th><th>Starting guide</th></tr></thead><tbody><tr><td>Spreadsheets &amp; price tables</td><td>Averaging listed prices instead of revenue ÷ total units, or shifting midnight cutoffs</td><td>Recalculate raw sums independently on a small fixture CSV before scaling</td><td><a href="/guides/verify-ai-weighted-average-price-spreadsheet/">Verify weighted prices</a></td></tr><tr><td>Structured JSON &amp; meeting records</td><td>Synthesizing missing due dates, owners, or enum keys to look complete</td><td>Validate required keys, frozen lines, and explicit <code>[TO CONFIRM]</code> flags</td><td><a href="/guides/ai-valid-json-without-inventing-data/">Valid JSON without inventing data</a></td></tr><tr><td>PDFs, charts &amp; multi-file comparisons</td><td>Skipping raster-only pages or missing side-by-side policy additions and deletions</td><td>Verify character extraction count and inspect surrounding source tables</td><td><a href="/troubleshooting/ai-pdf-summary-missing-tables-ocr-check/">PDF OCR layer check</a></td></tr><tr><td>Policies, privacy &amp; external claims</td><td>Turning a missing detail into an invented policy rule or leaking sensitive fields</td><td>Classify supported vs contradicted vs unresolved claims separately</td><td><a href="/guides/how-to-verify-ai-generated-information/">Verify AI-generated information</a></td></tr></tbody></table><h2>Three rules that prevent costly rework</h2><ol><li><strong>Keep source data alongside the output:</strong> never ask an assistant to edit facts while discarding the raw original input.</li><li><strong>Test failure cases on purpose:</strong> blank rows, timezone offsets, and contradictory clauses expose fragile instructions immediately.</li><li><strong>Separate reading convenience from proof:</strong> a readable paragraph, well-formatted CSV, or fluent citation needs direct inspection against primary evidence before sign-off.</li></ol></section>}
{category.slug === 'prompts' && <section class="section prose info-content" aria-labelledby="prompts-method-heading"><h2 id="prompts-method-heading">How to choose and test a structured prompt pattern</h2><p>Effective prompts work more like engineering specifications than magic phrases. When an instruction combines open-ended creativity with strict factual preservation—or asks for five formatting rules in one loose paragraph—models frequently satisfy tone while dropping constraints. Picking the smallest structured pattern for your job keeps revisions predictable.</p><table><thead><tr><th>Prompt approach</th><th>Best suited for</th><th>Main weakness to guard against</th><th>Matching guide</th></tr></thead><tbody><tr><td>Five-part role &amp; constraint template</td><td>Multi-deliverable drafts, structured memos, and client-ready summaries</td><td>Mixing verified context with unconfirmed assumptions in the same block</td><td><a href="/prompts/a-practical-ai-prompt-framework/">Practical AI prompt framework</a></td></tr><tr><td>Parameterized reusable template</td><td>Repeating weekly tasks across new datasets without editing instructions</td><td>Carrying over names, dates, or old client limits from the previous run</td><td><a href="/prompts/how-to-build-reusable-prompt-templates/">Build reusable templates</a></td></tr><tr><td>Few-shot rule examples</td><td>Classification, sentiment tagging, or strict tone routing</td><td>Surface keyword mimicry instead of obeying the decision rule</td><td><a href="/prompts/few-shot-prompt-examples-teach-rules-not-keywords/">Few-shot examples that teach rules</a></td></tr><tr><td>Scoped single-section revision</td><td>Updating one paragraph of an approved document without silent edits elsewhere</td><td>Drifting approved lines, timestamps, or compliance clauses outside the target span</td><td><a href="/prompts/revise-one-ai-answer-section-without-changing-approved-text/">Revise one section safely</a></td></tr></tbody></table><h2>Five checks before trusting any prompt template</h2><ol><li><strong>Explicit output boundary:</strong> specify exact length, headings, JSON fields, or bullet counts you can check in seconds.</li><li><strong>Missing-data fallback:</strong> instruct what placeholder (such as <code>[TO CONFIRM]</code> or <code>null</code>) to emit rather than guessing.</li><li><strong>Negative example test:</strong> try one ambiguous or incomplete input case in the <a href="/tools/ai-prompt-builder/">AI Prompt Builder</a> and confirm it stays conservative.</li><li><strong>Small evaluation baseline:</strong> score candidate prompt versions across 8–12 repeatable cases before adopting one as a standard workflow.</li><li><strong>Clean handoff rule:</strong> isolate sensitive keys or private client inputs before pasting templates into external tools.</li></ol></section>}
{category.slug === 'ai-tools' && <section class="section prose info-content" aria-labelledby="tool-decisions"><h2 id="tool-decisions">Decide which kind of answer you actually need</h2><p>Different AI features solve different problems. Begin with the evidence and the decision, not a product label. A regular conversation is useful for outlining an email or reorganizing text you already understand. Search becomes more relevant when an answer depends on a current third-party statement. Deep Research is for a larger evidence-gathering task where several sources, conflicting claims and explicit coverage matter; availability and limits can depend on your plan.</p><table><thead><tr><th>Your task</th><th>A reasonable starting point</th><th>What still needs checking</th></tr></thead><tbody><tr><td>Rewrite a paragraph of fictional meeting notes</td><td>Standard conversation</td><td>Whether people, dates and commitments stayed unchanged</td></tr><tr><td>Find the latest official product documentation</td><td>Search with primary sources</td><td>Whether the linked page actually supports each feature claim</td></tr><tr><td>Compare competing approaches across several documents</td><td>Multi-source research with an evidence table</td><td>Coverage gaps, publication dates and contrary evidence</td></tr></tbody></table><p><strong>Stop condition:</strong> if you cannot name the original source for an important assertion, do not present the generated statement as independently confirmed. If you are working with private workplace material, check your organization's sharing rules and the product's current data controls before uploading anything. These are editorial routing recommendations, not guarantees of specific model access or performance.</p><h3>Before turning an AI workspace into a recurring habit</h3><ul><li><strong>Separate reference sources from rough drafts:</strong> inside recurring project folders or notebooks, freeze approved policy files so unreviewed brainstorms do not silently overwrite canonical requirements.</li><li><strong>Verify live search links directly:</strong> an inline citation proves a URL was attached, not that the cited paragraph says what the summary claims; open the passage and compare claims one by one.</li><li><strong>Audit privacy and memory defaults first:</strong> distinguish account training opt-outs, shared project workspaces, and temporary chat settings before adding client or workplace documents.</li></ul></section>}
{category.slug === 'troubleshooting' && <section class="section prose info-content" aria-labelledby="triage-guide"><h2 id="triage-guide">First identify which failure you have</h2><p>A fluent but inaccurate answer, an upload failure, lost context and a leaked credential may all feel like “AI is broken.” They require different responses. Use the smallest reversible check first and stop before a mistake becomes a disclosure or an unapproved decision.</p><table><thead><tr><th>Symptom</th><th>First useful check</th><th>Do not do this</th></tr></thead><tbody><tr><td>The answer cites a source but adds an unconfirmed date or price</td><td>Open the original reference and label the precise claim supported, contradicted or unknown</td><td>Ask the same model to certify its own answer without evidence</td></tr><tr><td>The tool cannot read a file</td><td>Check the original file locally, its format, size and whether selectable text exists; retry with a non-sensitive sample</td><td>Publish the private file to a public link just to test access</td></tr><tr><td>The assistant forgets approved constraints</td><td>Make a short, source-linked handoff of confirmed facts and current boundaries</td><td>Treat an earlier unverified guess as a new approved fact</td></tr><tr><td>You accidentally pasted an API key</td><td>Revoke or rotate the credential at its issuer and review usage</td><td>Assume deleting the chat makes the credential safe again</td></tr></tbody></table><p>These are general first actions, not incident investigations or tests of a particular AI service. For consequential harm, seek the appropriate service operator or professional support rather than experimenting with sensitive data.</p><h3>Fast post-incident recovery discipline</h3><ol><li><strong>Contain exposure before diagnosing prompt phrasing:</strong> credential rotation, shared-link revocation, and removing copied files happen first; prompt cleanup waits.</li><li><strong>Distinguish platform errors from text normalization bugs:</strong> invisible zero-width characters, smart quotes, or OCR-less scanned PDFs often break downstream matching without raising a visible error banner.</li><li><strong>Preserve exact failing inputs:</strong> saving a minimal non-sensitive reproduction makes it possible to verify whether a new workflow actually fixed the underlying defect.</li></ol></section>}
{category.slug === 'tools' && <section class="section prose info-content" aria-labelledby="tool-picker-heading"><h2 id="tool-picker-heading">Choose a check by what you need to finish</h2>
  <p>These are four browser tools with distinct outputs. One lets you practise a fictional answer key or build a separate, manually reviewed claim register. None contacts an AI model, certifies an answer, or checks an external account.</p>
  <table><thead><tr><th>You need to</th><th>Start here</th><th>What you can keep</th><th>What remains unverified</th></tr></thead><tbody>
  <tr><td>Turn a vague instruction into a prompt</td><td><a href="/tools/ai-prompt-builder/">Prompt Builder</a></td><td>A text prompt you can copy or download</td><td>Whether another AI follows the prompt</td></tr>
  <tr><td>Review an answer before acting on it</td><td><a href="/tools/ai-response-checklist/">Response Checklist</a></td><td>A six-point review in the current page</td><td>Whether each factual claim is true</td></tr>
  <tr><td>Reconcile prices and quantities</td><td><a href="/tools/weighted-price-checker/">Weighted Average Audit</a></td><td>Calculated totals and row-level checks in the browser</td><td>Whether your original business records are authentic</td></tr>
  <tr><td>Learn supported vs contradicted vs unknown</td><td><a href="/tools/claim-checker/">Source Claim Verifier quiz</a></td><td>Feedback for 5 or 22 fictional claims</td><td>Whether a real-world claim is true</td></tr>
  <tr><td>Record checks against documents you already have</td><td><a href="/tools/claim-checker/#manual-claim-ledger">Manual claim ledger</a></td><td>Up to 30 human-reviewed entries as a TSV download request</td><td>Source authenticity, judgment accuracy, and successful file saving</td></tr>
  </tbody></table>
  <p><strong>Two source-first ways to begin:</strong> To check a number, download the <a href="/examples/weighted-price-sample.csv">eight-row fictional sales sample</a> and open the <a href="/tools/weighted-price-checker/">workbench</a>. Its arithmetic reference is 27 units, 530.00 in revenue and 19.63 revenue per sold unit (530 ÷ 27, rounded to two decimals). A simple average of listed prices gives a different answer because it ignores quantities. <a href="/guides/verify-ai-weighted-average-price-spreadsheet/">See the independent calculation</a>.</p>
  <p>To check a statement, read the <a href="/examples/claim-boundary-source-notes.txt">fictional community-garden notes</a> first. “The meeting is on Saturday” is supported; “it will take place in North Greenhouse” is not established; “the location is already confirmed” contradicts the note explicitly stating that it is unconfirmed. Use the <a href="/tools/claim-checker/">quiz</a> to learn the difference, or <a href="/tools/claim-checker/#manual-claim-ledger">go straight to your own claim ledger</a> to record a traceable human judgment. These outcomes follow from the published teaching data, not a live AI model test.</p>
  <p class="small muted">Your own entries are held only in the open page and are not automatically saved. Download your review before leaving, and check the browser's download list: requesting a TSV file does not prove that the browser saved it. Use fictional or non-sensitive source text on shared devices.</p>
</section>}
{category.slug === 'tools' && <section class="section prose" aria-labelledby="tool-checks-title"><h2 id="tool-checks-title">Four checks, four different purposes</h2><p>Start with the question that you can actually test. The prompt builder organizes the inputs and output format for a task; it cannot prove that an AI answer is true. The response checklist helps you inspect source claims, omissions and uncertainty; marking boxes does not verify a claim by itself. The weighted-average workbench checks numbers independently, but it is not an accounting system. The source claim verifier teaches the difference between contradicted and unknown statements and provides an optional human-reviewed TSV ledger; neither mode independently certifies real-world claims.</p><p>If you want a downloadable reference dataset with an expected answer, open the <a href="/evidence/">Evidence Library</a> and try one deliberate failure case before using any tool with your own information. Avoid entering confidential customer or workplace records.</p><h3>Why browser-only tools matter for privacy and accuracy</h3><p>Keeping calculations and text checks client-side means you can test workflows quickly without sending workplace rows, drafts, or study notes to external APIs. Combine the Prompt Builder before starting an AI session with the Response Checklist, Weighted Average Audit, or Source Claim Verifier afterward to turn ad-hoc spot-checks into a repeatable review habit.</p></section>}
{category.slug === 'tools' ? <div class="tools-grid"><a class="tool-card" href="/tools/ai-prompt-builder/"><span class="eyebrow mint">Compose / no AI required</span><h2>AI Prompt Builder ↗</h2><p>Combine your goal, context, audience, constraints, and output format into a prompt you can copy or download.</p></a><a class="tool-card" href="/tools/ai-response-checklist/"><span class="eyebrow mint">Review / use your judgment</span><h2>AI Response Quality Checklist ↗</h2><p>Work through six practical checks before relying on an AI response. Track your review without sending us your data.</p></a><a class="tool-card" href="/tools/weighted-price-checker/"><span class="eyebrow mint">Audit / reproduce the numbers</span><h2>Weighted Average Audit Workbench ↗</h2><p>Paste fictional CSV data, check per-row revenue, reconcile channel totals, and flag missing prices before trusting AI arithmetic.</p></a><a class="tool-card" href="/tools/claim-checker/"><span class="eyebrow mint">Verify / quiz + manual ledger</span><h2>Source Claim Verifier ↗</h2><p>Compare 5 or 22 fictional source claims, then record your own judgments in a downloadable human-reviewed TSV register. No automatic fact-checking.</p></a></div> : <><p class="small muted mono">{posts.length} {posts.length === 1 ? 'guide' : 'guides'} / open a guide to get started</p><ArticleList posts={posts} /></>}
</Base>
