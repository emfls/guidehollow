---
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import { publishedArticles, articleUrl } from '../lib/content';
import { categories, site } from '../config';
const posts = await publishedArticles();
const featured = posts.filter(p => p.data.featured).slice(0, 3);
const startSlugs = ['what-is-generative-ai', 'how-to-write-better-ai-prompts', 'how-to-verify-ai-generated-information'];
const startArticles = startSlugs.flatMap((slug, index) => { const post = posts.find(p => p.data.slug === slug); return post ? [{post, index}] : []; });
---
<Base title={site.name}>
  <section class="hero" aria-labelledby="hero-title"><div class="hero-copy">
    <div class="terminal-line"><span class="status-dot"></span> guidehollow@web:~$ explore ai</div>
    <h1 id="hero-title">Less guesswork.<br />More <span>understanding.</span></h1>
    <p class="hero-description">A clearer path through AI.</p><p class="hero-detail">Practical guides, thoughtful prompts, and small tools to help you make AI useful in the real world.</p>
    <div class="hero-actions"><a class="button primary" href="/guides/">Explore the guides <span aria-hidden="true">↗</span></a><a class="text-link" href="/tools/">Try a free tool →</a></div>
  </div><div class="hero-terminal" aria-label="A practical AI workflow"><div class="terminal-bar"><span>~/a-clearer-path</span><span aria-hidden="true">− &nbsp; □ &nbsp; ×</span></div><div class="terminal-body"><p><span class="mint">$</span> cat approach.md</p><p class="terminal-comment"># Good questions. Better judgment.</p><div class="terminal-step"><span>01</span><div>Understand the basics<small>Start with a clear mental model.</small></div></div><div class="terminal-step"><span>02</span><div>Put ideas into practice<small>Try a prompt. Build a workflow.</small></div></div><div class="terminal-step"><span>03</span><div>Check before you trust<small>Keep your own judgment in the loop.</small></div></div><p class="terminal-ready"><span class="mint">✓</span> Ready when you are.<span class="cursor" aria-hidden="true">▍</span></p></div></div></section>
  <section class="search-band" aria-label="Find a guide"><form action="/search/" role="search"><label for="home-search"><span aria-hidden="true">⌕</span> What would you like to figure out?</label><div class="search-input-wrap"><span class="mint mono" aria-hidden="true">$</span><input type="search" id="home-search" name="q" placeholder="Search guides, prompts, and troubleshooting…" /><button type="submit">Search <kbd>↵</kbd></button></div></form><p class="small muted">Try: <a href="/search/?q=prompts">better prompts</a> <span>·</span> <a href="/search/?q=privacy">privacy</a> <span>·</span> <a href="/search/?q=spreadsheet">spreadsheets</a></p></section>
  <section class="section" id="start-here"><div class="section-heading"><div><p class="eyebrow mint">/ start_here</p><h2>New to AI? Begin here.</h2></div><p class="muted">Useful first steps. No jargon required.</p></div><ol class="start-path">{startArticles.map(({post,index}, i) => <li><span class="path-number">0{i + 1}</span><div><p class="eyebrow">{['Get your bearings', 'Ask a better question', 'Build good judgment'][index]}</p><h3><a href={articleUrl(post)}>{post.data.title}</a></h3></div><span aria-hidden="true">→</span></li>)}</ol></section>
  <section class="section"><div class="section-heading"><div><p class="eyebrow mint">/ explore</p><h2>Find your next step.</h2></div><a class="text-link" href="/guides/">Browse all guides →</a></div><div class="category-grid">{categories.map((c,i) => <a class="category-block" href={`/${c.slug}/`}><span class="mono muted">0{i + 1} / {c.command}</span><h3>{c.name} <span aria-hidden="true">↗</span></h3><p>{c.label}</p></a>)}</div></section>
  <section class="section"><div class="section-heading"><div><p class="eyebrow mint">/ featured</p><h2>A little clarity goes a long way.</h2></div><span class="small muted">Useful starting points, selected by topic</span></div><ArticleList posts={featured} /></section>
  <div class="two-column section"><section><div class="section-heading"><div><p class="eyebrow mint">/ ai_tools</p><h2>Know the tool.<br />Use it thoughtfully.</h2></div></div><ArticleList posts={posts.filter(p => p.data.category === 'ai-tools')} compact /></section><section><div class="section-heading"><div><p class="eyebrow mint">/ prompt_library</p><h2>Better instructions.<br />Less back-and-forth.</h2></div></div><ArticleList posts={posts.filter(p => p.data.category === 'prompts').slice(0, 2)} compact /><a class="text-link" href="/prompts/">Open the prompt library →</a></section></div>
  <section class="tool-feature section"><div><p class="eyebrow mint">/ free_tools</p><h2>Small tools.<br />Useful by design.</h2><p>No sign-up. No AI requests.<br />Everything runs in your browser.</p></div><div class="tool-links"><a href="/tools/ai-prompt-builder/"><span class="mono mint">01 / compose</span><h3>AI Prompt Builder <span aria-hidden="true">↗</span></h3><p>Turn a rough idea into a structured prompt.</p></a><a href="/tools/ai-response-checklist/"><span class="mono mint">02 / review</span><h3>Response Quality Checklist <span aria-hidden="true">↗</span></h3><p>Give an AI answer a careful second look.</p></a></div></section>
  <section class="section"><div class="section-heading"><div><p class="eyebrow mint">/ latest</p><h2>Fresh from the reading room.</h2></div><a class="text-link" href="/rss.xml">Follow via RSS ↗</a></div><ArticleList posts={posts.slice(0, 5)} /></section>
  <aside class="editorial-note"><span class="mono mint">Our approach</span><p>Clear explanations. Official sources. Honest limitations.<br /><a href="/editorial-policy/">Read our editorial policy →</a></p></aside>
</Base>
