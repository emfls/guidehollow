---
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import { publishedArticles, articleUrl } from '../lib/content';
import { categories, site } from '../config';
import { latestArticleActivity } from '../lib/editorial-activity';
const posts = await publishedArticles();
const latest = latestArticleActivity(posts).slice(0, 5);
const featured = posts.filter(p => p.data.featured).slice(0, 3);
const startSlugs = ['what-is-generative-ai', 'how-to-write-better-ai-prompts', 'how-to-verify-ai-generated-information'];
const startArticles = startSlugs.flatMap((slug, index) => { const post = posts.find(p => p.data.slug === slug); return post ? [{post, index}] : []; });
---
<Base title={site.name}>
  <section class="hero" aria-labelledby="hero-title"><div class="hero-copy">
    <div class="terminal-line"><span class="status-dot"></span> guidehollow@web:~$ explore ai</div>
    <h1 id="hero-title">Less guesswork.<br />More <span>understanding.</span></h1>
    <p class="hero-description">Practice with inputs you can inspect.</p><p class="hero-detail">Download example data, compare actual responses with source material, and use review criteria to check your own results.</p>
    <div class="hero-actions"><a class="button primary" href="/guides/">Explore the guides <span aria-hidden="true">↗</span></a><a class="text-link" href="/tools/">Try a free tool →</a></div>
  </div><div class="hero-terminal" aria-label="A practical AI workflow"><div class="terminal-bar"><span>~/a-clearer-path</span><span aria-hidden="true">− &nbsp; □ &nbsp; ×</span></div><div class="terminal-body"><p><span class="mint">$</span> cat approach.md</p><p class="terminal-comment"># Good questions. Better judgment.</p><div class="terminal-step"><span>01</span><div>Understand the basics<small>Start with a clear mental model.</small></div></div><div class="terminal-step"><span>02</span><div>Put ideas into practice<small>Try a prompt. Build a workflow.</small></div></div><div class="terminal-step"><span>03</span><div>Check before you trust<small>Keep your own judgment in the loop.</small></div></div><p class="terminal-ready"><span class="mint">✓</span> Ready when you are.<span class="cursor" aria-hidden="true">▍</span></p></div></div></section>
  <section class="search-band" aria-label="Find a guide"><form action="/search/" role="search"><label for="home-search"><span aria-hidden="true">⌕</span> What would you like to figure out?</label><div class="search-input-wrap"><span class="mint mono" aria-hidden="true">$</span><input type="search" id="home-search" name="q" placeholder="Search guides, prompts, and troubleshooting…" /><button type="submit">Search <kbd>↵</kbd></button></div></form><p class="small muted">Try: <a href="/search/?q=prompts">better prompts</a> <span>·</span> <a href="/search/?q=privacy">privacy</a> <span>·</span> <a href="/search/?q=spreadsheet">spreadsheets</a></p></section>
  <section class="section"><div class="section-heading"><div><p class="eyebrow mint">/ featured</p><h2>Worked examples you can check.</h2></div><span class="small muted">A spreadsheet with expected values, a document coverage check, and a two-turn conversation</span></div><ArticleList posts={featured} /></section>
  <section class="section" aria-labelledby="independent-check-title">
    <div class="section-heading"><div><p class="eyebrow mint">/ inspect_the_work</p><h2 id="independent-check-title">Try the numbers. See what breaks.</h2></div><p class="muted">Our fictional inputs, expected results and failure cases are available to verify. On November 1, 2026, we also <a href="/evidence/">ran our public weighted-price tool in a real browser</a>, captured the results and disclosed what was not tested.</p></div>
    <ol class="start-path">
      <li><span class="path-number">01</span><div><p class="eyebrow">Reproducible input</p><h3><a href="/examples/weighted-price-sample.csv">Download an 8-row sales CSV</a></h3><p class="small muted">Includes a zero-quantity line and a genuine zero-price line.</p></div></li>
      <li><span class="path-number">02</span><div><p class="eyebrow">Independent calculation</p><h3><a href="/tools/weighted-price-checker/">Check units, revenue, and a weighted price</a></h3><p class="small muted">Paste the rows, inspect channel totals, and try deliberate input errors.</p></div></li>
      <li><span class="path-number">03</span><div><p class="eyebrow">Explain the result</p><h3><a href="/guides/verify-ai-weighted-average-price-spreadsheet/">Review the formula and cross-checks</a></h3><p class="small muted">Follow the Excel and Sheets method, and compare with expected values.</p></div></li>
    </ol>
    <p class="small muted">This is a teaching fixture with invented transactions, not evidence of a live AI model benchmark or a real merchant's sales. <a href="/evidence/">Explore the original evidence library and other reproducible checks →</a></p>
  </section>
  <section class="section" aria-labelledby="fact-boundary-title">
    <div class="section-heading"><div><p class="eyebrow mint">/ check_the_claim</p><h2 id="fact-boundary-title">Know the difference between false and unknown.</h2></div><p class="muted">A statement can contradict the source, or it can merely lack evidence. Those require different repairs.</p></div>
    <ol class="start-path">
      <li><span class="path-number">01</span><div><p class="eyebrow">Read the source</p><h3><a href="/examples/claim-boundary-source-notes.txt">Three short fictional notes</a></h3><p class="small muted">A garden meeting, a proposed software feature and an unconfirmed event.</p></div></li>
      <li><span class="path-number">02</span><div><p class="eyebrow">Make a judgment</p><h3><a href="/examples/claim-boundary-audit.csv">Classify 22 factual claims</a></h3><p class="small muted">12 are supported, 6 directly contradicted and 4 left unsupported by the notes. Check the answers after deciding for yourself.</p></div></li>
      <li><span class="path-number">03</span><div><p class="eyebrow">Explain the error</p><h3><a href="/troubleshooting/why-ai-gives-wrong-answers/">Learn to repair claims without guessing</a></h3><p class="small muted">Change a source note and observe which conclusions actually need to change.</p></div></li>
    </ol>
    <p class="small muted">These are <strong>editor-created</strong> teaching cases—not model-generated predictions. All source files, scoring limits and other examples are explained in the <a href="/evidence/">public evidence library</a>.</p>
  </section>
  <section class="section" id="start-here"><div class="section-heading"><div><p class="eyebrow mint">/ start_here</p><h2>New to AI? Begin here.</h2></div><p class="muted">Useful first steps. No jargon required.</p></div><ol class="start-path">{startArticles.map(({post,index}, i) => <li><span class="path-number">0{i + 1}</span><div><p class="eyebrow">{['Get your bearings', 'Ask a better question', 'Build good judgment'][index]}</p><h3><a href={articleUrl(post)}>{post.data.title}</a></h3></div><span aria-hidden="true">→</span></li>)}</ol></section>
  <section class="section"><div class="section-heading"><div><p class="eyebrow mint">/ explore</p><h2>Find your next step.</h2></div><a class="text-link" href="/guides/">Browse all guides →</a></div><div class="category-grid">{categories.map((c,i) => <a class="category-block" href={`/${c.slug}/`}><span class="mono muted">0{i + 1} / {c.command}</span><h3>{c.name} <span aria-hidden="true">↗</span></h3><p>{c.label}</p></a>)}</div></section>

  <div class="two-column section"><section><div class="section-heading"><div><p class="eyebrow mint">/ ai_tools</p><h2>Know the tool.<br />Use it thoughtfully.</h2></div></div><ArticleList posts={posts.filter(p => p.data.category === 'ai-tools')} compact /></section><section><div class="section-heading"><div><p class="eyebrow mint">/ prompt_library</p><h2>Better instructions.<br />Less back-and-forth.</h2></div></div><ArticleList posts={posts.filter(p => p.data.category === 'prompts').slice(0, 2)} compact /><a class="text-link" href="/prompts/">Open the prompt library →</a></section></div>
  <section class="tool-feature section"><div><p class="eyebrow mint">/ free_tools</p><h2>Small tools.<br />Useful by design.</h2><p>No sign-up. No AI requests.<br />Everything runs in your browser.</p></div><div class="tool-links"><a href="/tools/ai-prompt-builder/"><span class="mono mint">01 / compose</span><h3>AI Prompt Builder <span aria-hidden="true">↗</span></h3><p>Turn a rough idea into a structured prompt.</p></a><a href="/tools/ai-response-checklist/"><span class="mono mint">02 / review</span><h3>Response Quality Checklist <span aria-hidden="true">↗</span></h3><p>Give an AI answer a careful second look.</p></a><a href="/tools/weighted-price-checker/"><span class="mono mint">03 / audit</span><h3>Weighted Average Audit <span aria-hidden="true">↗</span></h3><p>Independently verify spreadsheet arithmetic and input quality.</p></a><a href="/tools/claim-checker/"><span class="mono mint">04 / verify</span><h3>Source Claim Verifier <span aria-hidden="true">↗</span></h3><p>Practice 5 or 22 original evidence-based claim checks, with explanations.</p></a></div></section>
  <section class="section" aria-labelledby="recent-activity-title"><div class="section-heading"><div><p class="eyebrow mint">/ latest</p><h2 id="recent-activity-title">Recently published or revised.</h2></div><a class="text-link" href="/rss.xml">Follow via RSS ↗</a></div><ArticleList posts={latest} showActivityDates /><p class="editorial-activity-note">Dates distinguish new guides from updates to earlier ones. A revised guide retains its original publication date and explains the limits of its evidence; see our <a href="/editorial-policy/">editorial policy</a>.</p></section>
  <aside class="editorial-note"><span class="mono mint">Our approach</span><p>Clear explanations. Official sources. Honest limitations.<br /><a href="/editorial-policy/">Read our editorial policy →</a></p></aside>
</Base>
