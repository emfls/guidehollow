---
import { site } from '../config';
interface Props { slot?: string }
const { slot } = Astro.props;
const enabled = site.ads.servingEnabled && site.ads.consentReady && site.ads.publisherId && slot && /^\d+$/.test(slot);
---
{enabled && <aside aria-label="Advertisement" class="ad-slot"><small>Advertisement</small><ins class="adsbygoogle" style="display:block" data-ad-client={site.ads.publisherId} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
<script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script></aside>}
